---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import CtaBand from '../components/CtaBand.astro';
import { site } from '../data/site';

const description =
  'AI Lab Consulting is a small senior team in Laguna Beach, California, helping regulated financial firms run AI agents they can account for.';
---

<BaseLayout title="About us" {description} type="AboutPage" crumbs={[{ name: 'About', href: '/about/' }]}>
  <PageHeader
    eyebrow="About"
    title="About us"
    lede="A small senior team helping regulated financial firms run AI agents they can account for."
  />

  <section class="section">
    <div class="container split">
      <h2 class="h">Background</h2>
      <div class="text">
        <p>
          We come from enterprise architecture and compliance work in regulated finance: identity and access, platform
          engineering, model risk and change control. That is why we design for the examination as well as for
          production.
        </p>
        <dl>
          <div>
            <dt>Email</dt>
            <dd><a href={`mailto:${site.email}`}>{site.email}</a></dd>
          </div>
          <div>
            <dt>Phone</dt>
            <dd><a href={`tel:${site.phone}`}>{site.phoneDisplay}</a></dd>
          </div>
          <div>
            <dt>Office</dt>
            <dd>
              {site.address.street},{' '}
              {`${site.address.locality}, ${site.address.region} ${site.address.postalCode}`}
            </dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  .h {
    font-size: var(--step-3);
  }

  .text > p {
    max-width: 38rem;
    font-size: var(--step-1);
    line-height: 1.55;
    color: var(--ink-soft);
  }

  dl {
    margin-top: 2.5rem;
    border-top: 1px solid var(--ink);
  }

  dl > div {
    display: grid;
    grid-template-columns: 6rem 1fr;
    gap: 1rem;
    padding-block: 1rem;
    border-bottom: 1px solid var(--rule);
  }

  dt {
    font-size: var(--step--1);
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--ink-muted);
    padding-top: 0.2em;
  }

  dd a {
    text-underline-offset: 0.2em;
  }
</style>
