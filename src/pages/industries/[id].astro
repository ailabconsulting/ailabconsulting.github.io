---
import { getCollection, getEntries, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import FaqList from '../../components/FaqList.astro';
import ServiceIndex from '../../components/ServiceIndex.astro';
import CtaBand from '../../components/CtaBand.astro';

export async function getStaticPaths() {
  const industries = await getCollection('industries');
  return industries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'industries'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const path = `/industries/${entry.id}/`;
const services = (await getEntries(entry.data.services)).sort((a, b) => a.data.order - b.data.order);
const title = `AI for ${entry.data.title.toLowerCase()}`;
// Four use cases fit one row; anything else reads best in rows of three.
const cols = entry.data.useCases.length === 4 ? 4 : 3;
---

<BaseLayout
  {title}
  description={entry.data.description}
  crumbs={[
    { name: 'Industries', href: '/industries/' },
    { name: entry.data.title, href: path },
  ]}
  faqs={entry.data.faqs}
>
  <PageHeader eyebrow="Industry" {title} lede={entry.data.summary} />

  <section class="section">
    <div class="container split">
      <div class="split-aside">
        <p class="eyebrow">Overview</p>
      </div>
      <article class="prose">
        <Content />
      </article>
    </div>
  </section>

  <section class="section section--sunk" aria-labelledby="cases-title">
    <div class="container">
      <p class="eyebrow">Use cases</p>
      <h2 id="cases-title" class="h">What we build for {entry.data.title.toLowerCase()}</h2>
      <ol class="cases" style={`--cols: ${cols}`}>
        {
          entry.data.useCases.map((u, i) => (
            <li>
              <span class="num">{String(i + 1).padStart(2, '0')}</span>
              <h3>{u.title}</h3>
              <p>{u.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="services-title">
    <div class="container">
      <p class="eyebrow">Services</p>
      <h2 id="services-title" class="h">Related services</h2>
      <ServiceIndex {services} />
    </div>
  </section>

  {
    entry.data.faqs.length > 0 && (
      <section class="section" aria-labelledby="faq-title">
        <div class="container split">
          <div class="split-aside">
            <p class="eyebrow">Questions</p>
            <h2 id="faq-title" class="h">Common questions</h2>
          </div>
          <FaqList faqs={entry.data.faqs} />
        </div>
      </section>
    )
  }

  <CtaBand />
</BaseLayout>

<style>
  .h {
    margin: 1.25rem 0 clamp(2rem, 4vw, 3rem);
    font-size: var(--step-4);
    max-width: 20ch;
  }

  .split-aside .h {
    margin-bottom: 0;
  }

  .cases {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0 2rem;
  }

  @media (min-width: 40rem) {
    .cases {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .cases {
      grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    }
  }

  .cases li {
    display: grid;
    gap: 0.65rem;
    align-content: start;
    padding: 1.5rem 0 2rem;
    border-top: 1px solid var(--ink);
  }

  .num {
    font-size: var(--step--1);
    color: var(--accent);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }

  .cases h3 {
    font-size: var(--step-2);
  }

  .cases p {
    color: var(--ink-soft);
  }
</style>
