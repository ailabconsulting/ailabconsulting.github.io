---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import { services } from '../data/services';
---

<BaseLayout description={site.metaDescription} withServices>
  <div class="container top">
    <section class="intro" aria-labelledby="intro-title">
      <h1 id="intro-title">AI governance for banks, insurers and fintechs</h1>
      <p class="lead">
        We help financial firms put AI agents into production with the controls their examiners and auditors expect.
        Every consequential action an agent takes has a named approver and a record, and the controls map to SR 11-7,
        SOX, DORA and the EU AI Act.
      </p>
      <p class="cta">
        <a class="button" href="#contact">Contact us</a>
        <span class="muted">or email <a href={`mailto:${site.email}`}>{site.email}</a></span>
      </p>
    </section>

    <section id="services" class="services" aria-labelledby="services-title">
      <h2 id="services-title">Services</h2>
      <dl>
        {
          services.map((s) => (
            <div id={s.id}>
              <dt>{s.name}</dt>
              <dd>{s.text}</dd>
            </div>
          ))
        }
      </dl>
      <p class="aside">
        We also build agent platforms, LLM applications and machine learning systems, including for manufacturing and
        retail.
      </p>
    </section>

    <div class="more">
    <section id="how" aria-labelledby="how-title">
      <h2 id="how-title">How engagements work</h2>
      <p>
        Engagements start with a fixed-scope assessment of your agents and controls. If you continue, we build the
        controls with your team on one workflow first, then extend them and hand over the documentation and evidence. You
        can stop after any step.
      </p>
    </section>
    <section id="about" aria-labelledby="about-title">
      <h2 id="about-title">About us</h2>
      <p>
        AI Lab Consulting is a small senior team with backgrounds in enterprise architecture and compliance at regulated
        financial firms. We design and build controls; legal interpretation and attestation stay with your compliance
        team and auditors.
      </p>
    </section>
    </div>
  </div>

  <section id="contact" class="container band contact" aria-labelledby="contact-title">
    <div>
      <h2 id="contact-title">Contact</h2>
      <p>Tell us which AI agents you run or plan to run, and we'll set up a call.</p>
      <p class="details">
        <a href={`mailto:${site.email}`}>{site.email}</a><br />
        <a href={`tel:${site.phone}`}>{site.phoneDisplay}</a><br />
        <span class="muted">{`${site.address.street}, ${site.address.locality}, ${site.address.region} ${site.address.postalCode}`}</span>
      </p>
    </div>

    <form
      class="contact-form"
      method="POST"
      action={site.formEndpoint}
      data-sitekey={site.recaptchaSiteKey}
      data-email={site.email}
    >
      <div class="row">
        <label>Name <input name="name" type="text" autocomplete="name" required /></label>
        <label>Work email <input name="email" type="email" autocomplete="email" required /></label>
      </div>
      <label><span>Company <span class="muted">(optional)</span></span> <input name="company" type="text" autocomplete="organization" /></label>
      <label>Message <textarea name="message" rows="4" required></textarea></label>
      <input type="hidden" name="page" value="/" />
      <div class="hp" aria-hidden="true">
        <label>Leave this field empty <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" /></label>
      </div>
      <div class="captcha"></div>
      <div class="submit">
        <button class="button" type="submit">Send</button>
        <p class="fineprint muted">
          Protected by reCAPTCHA. Google's <a href="https://policies.google.com/privacy">Privacy Policy</a> and{' '}
          <a href="https://policies.google.com/terms">Terms of Service</a> apply.
        </p>
      </div>
      <p class="status" role="status" aria-live="polite"></p>
    </form>
  </section>
</BaseLayout>

<script>
  // Without JS the form posts straight to Getform. With JS, invisible reCAPTCHA
  // loads on first interaction and the form submits in place.
  type Grecaptcha = {
    render(el: Element, opts: Record<string, unknown>): number;
    execute(id: number): void;
    reset(id: number): void;
  };
  declare global {
    interface Window {
      grecaptcha?: Grecaptcha;
      __onRecaptchaLoad?: () => void;
    }
  }

  const form = document.querySelector<HTMLFormElement>('form.contact-form');
  if (form) {
    const status = form.querySelector<HTMLElement>('.status')!;
    const button = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
    let widgetId: number | undefined;
    let ready: Promise<void> | undefined;

    const loadCaptcha = () =>
      (ready ??= new Promise<void>((resolve, reject) => {
        window.__onRecaptchaLoad = () => {
          widgetId = window.grecaptcha!.render(form.querySelector('.captcha')!, {
            sitekey: form.dataset.sitekey,
            size: 'invisible',
            callback: () => send(),
          });
          resolve();
        };
        const s = document.createElement('script');
        s.src = 'https://www.google.com/recaptcha/api.js?onload=__onRecaptchaLoad&render=explicit';
        s.async = true;
        s.onerror = () => reject(new Error('reCAPTCHA failed to load'));
        document.head.append(s);
      }));

    form.addEventListener('focusin', () => loadCaptcha().catch(() => {}), { once: true });

    const setStatus = (text: string, kind: 'ok' | 'error' | '') => {
      status.textContent = text;
      status.dataset.kind = kind;
    };

    async function send() {
      try {
        const res = await fetch(form!.action, {
          method: 'POST',
          body: new URLSearchParams(new FormData(form!) as unknown as Record<string, string>),
          headers: { Accept: 'application/json' },
        });
        if (!res.ok) throw new Error(String(res.status));
        form!.reset();
        setStatus("Thank you. We've received your message and will reply to set up a call.", 'ok');
      } catch {
        setStatus(`Sorry, the message could not be sent. Please email ${form!.dataset.email}.`, 'error');
      } finally {
        button.disabled = false;
        if (widgetId !== undefined) window.grecaptcha?.reset(widgetId);
      }
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      button.disabled = true;
      setStatus('Sending...', '');
      try {
        await loadCaptcha();
        window.grecaptcha!.execute(widgetId!);
      } catch {
        await send();
      }
    });
  }
</script>

<style>
  .top {
    display: grid;
    gap: 2.5rem;
    padding-block: var(--space);
  }

  .intro {
    grid-area: intro;
  }

  .services {
    grid-area: services;
  }

  .more {
    grid-area: more;
    display: grid;
    gap: 1.75rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--rule);
  }

  .top {
    grid-template-areas: 'intro' 'services' 'more';
  }

  @media (min-width: 56rem) {
    .top {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      grid-template-areas:
        'intro services'
        'more services';
      grid-template-rows: auto 1fr;
      column-gap: 4rem;
      row-gap: 2.5rem;
      align-items: start;
    }
  }

  h1 {
    font-size: clamp(1.9rem, 1.35rem + 1.9vw, 2.6rem);
    letter-spacing: -0.01em;
  }

  .lead {
    margin-top: 1.25rem;
    font-size: 1.15rem;
    max-width: 36rem;
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
    margin-top: 1.75rem;
  }

  h2 {
    font-size: 1.15rem;
    margin-bottom: 0.75rem;
  }

  .services dl > div {
    padding-block: 0.85rem;
    border-top: 1px solid var(--rule);
    scroll-margin-top: 1rem;
  }

  .services dt {
    font-weight: 600;
  }

  .services dd {
    margin-top: 0.15rem;
    color: #3d424a;
  }

  .aside {
    padding-top: 0.85rem;
    border-top: 1px solid var(--rule);
    color: var(--muted);
    font-size: 0.95rem;
  }

  .band {
    padding-block: var(--space);
    border-top: 1px solid var(--rule);
  }

  .more p {
    color: #3d424a;
    max-width: 36rem;
  }

  .contact {
    display: grid;
    gap: 2rem;
  }

  @media (min-width: 56rem) {
    .contact {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
      gap: 4rem;
    }
  }

  .details {
    margin-top: 1rem;
    line-height: 1.8;
  }

  .contact-form {
    display: grid;
    gap: 1rem;
  }

  .row {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 36rem) {
    .row {
      grid-template-columns: 1fr 1fr;
    }
  }

  label {
    display: grid;
    gap: 0.3rem;
    font-size: 0.95rem;
    font-weight: 500;
  }

  label .muted {
    font-weight: 400;
  }

  input,
  textarea {
    width: 100%;
    padding: 0.6rem 0.75rem;
    border: 1px solid var(--field);
    border-radius: 4px;
    background: #fff;
    color: var(--text);
    font: inherit;
    font-weight: 400;
  }

  textarea {
    resize: vertical;
  }

  input:focus,
  textarea:focus {
    outline: 2px solid var(--accent);
    outline-offset: 0;
    border-color: var(--accent);
  }

  .hp {
    position: absolute;
    left: -9999px;
  }

  .submit {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
  }

  button[disabled] {
    opacity: 0.6;
    cursor: progress;
  }

  .fineprint {
    flex: 1 1 14rem;
    font-size: 0.8rem;
    line-height: 1.45;
  }

  .status:empty {
    display: none;
  }

  .status[data-kind='ok'] {
    color: #1b6b43;
  }

  .status[data-kind='error'] {
    color: #a3261b;
  }

  /* Attribution is in the fine print, so the badge can be hidden (visibility, not display). */
  .captcha :global(.grecaptcha-badge) {
    visibility: hidden;
  }
</style>
