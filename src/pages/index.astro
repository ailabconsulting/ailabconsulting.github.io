---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceIndex from '../components/ServiceIndex.astro';
import FaqList from '../components/FaqList.astro';
import CtaBand from '../components/CtaBand.astro';
import HeroArt from '../components/HeroArt.astro';
import { site } from '../data/site';
import { faqs } from '../data/faqs';
import { process } from '../data/process';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);

const outcomes = [
  {
    title: 'Agents in production sooner',
    text: 'Controls are part of the design, so risk and compliance can sign off without a rebuild.',
  },
  {
    title: 'A named approver for every consequential action',
    text: 'Approvals are tied to the exact action and checked before it runs.',
  },
  {
    title: 'Answers for examiners',
    text: 'Who approved what, and on what basis, is a query. Controls map to SR 11-7, SOX, DORA and the EU AI Act.',
  },
];
---

<BaseLayout description={site.metaDescription} faqs={faqs}>
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <p class="eyebrow">AI governance for financial services</p>
        <h1>AI agents that hold up <em>in an audit</em></h1>
        <p class="lede">
          We help banks, credit unions, insurers and fintechs put AI agents into production, with the approvals and
          records examiners expect.
        </p>
        <div class="actions">
          <a href="/contact/" class="btn btn-primary">Book a call <span class="arrow" aria-hidden="true">→</span></a>
          <a href="/services/" class="link-arrow">See services</a>
        </div>
      </div>
      <HeroArt />
    </div>
  </section>

  <section class="section section--sunk" aria-labelledby="value-title">
    <div class="container">
      <h2 id="value-title" class="h2">What you get</h2>
      <ul class="outcomes">
        {
          outcomes.map((o) => (
            <li>
              <h3>{o.title}</h3>
              <p>{o.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section" id="services" aria-labelledby="services-title">
    <div class="container">
      <h2 id="services-title" class="h2">Services</h2>
      <ServiceIndex {services} />
      <p class="note">
        We also build agent platforms, LLM applications and machine learning systems.{' '}
        <a href="/contact/">Talk to us</a>
      </p>
    </div>
  </section>

  <section class="section section--sunk" id="how" aria-labelledby="how-title">
    <div class="container">
      <h2 id="how-title" class="h2">How we work</h2>
      <p class="intro">
        A small senior team with backgrounds in enterprise architecture and compliance at regulated financial firms.
        You decide after each step whether to continue.
      </p>
      <ol class="steps">
        {
          process.map((s, i) => (
            <li>
              <span class="num">{i + 1}</span>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section" id="faq" aria-labelledby="faq-title">
    <div class="container split">
      <h2 id="faq-title" class="h2">Questions</h2>
      <FaqList {faqs} />
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  .hero {
    padding-block: clamp(3rem, 8vw, 6.5rem);
  }

  .hero-grid {
    display: grid;
    gap: 3rem;
    align-items: center;
  }

  .hero-grid > :global(.hero-art) {
    display: none;
  }

  @media (min-width: 60rem) {
    .hero-grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    }
    .hero-grid > :global(.hero-art) {
      display: block;
      justify-self: end;
    }
  }

  h1 em {
    white-space: nowrap;
  }

  h1 {
    margin-top: 1.5rem;
    max-width: 14ch;
    font-size: var(--step-5);
    font-weight: 350;
    line-height: 1.02;
    letter-spacing: -0.025em;
  }

  .hero .lede {
    margin-top: 1.75rem;
    max-width: 34rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.75rem;
    margin-top: 2.25rem;
  }

  .h2 {
    font-size: var(--step-4);
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .outcomes {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0 2.5rem;
  }

  @media (min-width: 56rem) {
    .outcomes {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .outcomes li {
    display: grid;
    gap: 0.6rem;
    align-content: start;
    padding: 1.5rem 0 2rem;
    border-top: 1px solid var(--ink);
  }

  .outcomes h3 {
    font-size: var(--step-2);
  }

  .outcomes p,
  .steps p,
  .intro,
  .note {
    color: var(--ink-soft);
  }

  .note {
    margin-top: 1.75rem;
  }

  .note a {
    color: var(--ink);
    font-weight: 500;
    text-underline-offset: 0.2em;
  }

  .intro {
    max-width: 40rem;
    margin: -1rem 0 2.5rem;
    font-size: var(--step-1);
    line-height: 1.5;
  }

  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0 2.5rem;
  }

  @media (min-width: 48rem) {
    .steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .steps li {
    display: grid;
    gap: 0.5rem;
    align-content: start;
    padding: 1.25rem 0 2rem;
    border-top: 1px solid var(--rule);
  }

  .num {
    font-family: var(--font-display);
    font-size: var(--step-3);
    line-height: 1;
    color: var(--accent);
  }

  .steps h3 {
    font-size: var(--step-2);
  }

  @media (min-width: 60rem) {
    #faq .split {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    }
  }
</style>
