---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import FaqList from '../../components/FaqList.astro';
import ServiceIndex from '../../components/ServiceIndex.astro';
import CtaBand from '../../components/CtaBand.astro';
import { service as serviceNode } from '../../lib/schema';

export async function getStaticPaths() {
  const services = await getCollection('services');
  return services.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'services'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const path = `/services/${entry.id}/`;
const others = (await getCollection('services', (s) => s.id !== entry.id)).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<BaseLayout
  title={entry.data.seoTitle ?? entry.data.title}
  description={entry.data.description}
  crumbs={[
    { name: 'Services', href: '/services/' },
    { name: entry.data.title, href: path },
  ]}
  faqs={entry.data.faqs}
  schema={[serviceNode({ path, name: entry.data.title, description: entry.data.description })]}
>
  <PageHeader eyebrow="Service" title={entry.data.title} lede={entry.data.summary} />

  <section class="section">
    <div class="container body">
      <div>
        <div class="prose">
          <Content />
        </div>
        <a href="/contact/" class="btn btn-primary cta">Book a call <span class="arrow" aria-hidden="true">→</span></a>
      </div>

      <aside class="card" aria-labelledby="deliverables-title">
        <h2 id="deliverables-title">What you get</h2>
        <ul class="tick-list">
          {entry.data.deliverables.map((d) => <li>{d}</li>)}
        </ul>
      </aside>
    </div>
  </section>

  {
    entry.data.faqs.length > 0 && (
      <section class="section" aria-labelledby="faq-title">
        <div class="container split">
          <h2 id="faq-title" class="h">Questions</h2>
          <FaqList faqs={entry.data.faqs} />
        </div>
      </section>
    )
  }

  <section class="section" aria-labelledby="more-title">
    <div class="container">
      <h2 id="more-title" class="h">Other services</h2>
      <ServiceIndex services={others} />
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  .body {
    display: grid;
    gap: 3rem;
  }

  @media (min-width: 60rem) {
    .body {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: 5rem;
      align-items: start;
    }
  }

  /* Service bodies are a single short paragraph; keep it at reading size. */
  .prose > :global(p:first-child) {
    font-family: var(--font-body);
    font-size: var(--step-1);
    line-height: 1.55;
    color: var(--ink-soft);
  }

  .cta {
    margin-top: 2rem;
  }

  .card {
    padding: 2rem;
    background: var(--paper-raised);
    border: 1px solid var(--rule);
    border-top: 3px solid var(--accent);
  }

  .card h2 {
    font-size: var(--step-2);
    margin-bottom: 1.5rem;
  }

  .h {
    font-size: var(--step-3);
    margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }
</style>
