---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import ServiceIndex from '../../components/ServiceIndex.astro';
import CtaBand from '../../components/CtaBand.astro';
import { service } from '../../lib/schema';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);

const description =
  'AI governance services for financial firms: assessments, approval and audit architecture, compliant AI-assisted engineering and a fractional AI lead.';

const schema = services.map((s) =>
  service({ path: `/services/${s.id}/`, name: s.data.title, description: s.data.description }),
);
---

<BaseLayout
  title="AI governance services"
  {description}
  type="CollectionPage"
  crumbs={[{ name: 'Services', href: '/services/' }]}
  {schema}
>
  <PageHeader
    eyebrow="Services"
    title="Services"
    lede="Each can be bought on its own. Most clients start with the assessment."
  />

  <section class="section">
    <div class="container">
      <ServiceIndex {services} headingLevel="h2" />
    </div>
  </section>

  <CtaBand />
</BaseLayout>
