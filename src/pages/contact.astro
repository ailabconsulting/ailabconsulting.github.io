---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import ContactForm from '../components/ContactForm.astro';
import { site } from '../data/site';

const description =
  'Contact AI Lab Consulting about a governance assessment, approval and audit architecture for AI agents, or fractional AI leadership.';

const next = [
  'We reply to every message and suggest a time for a short introductory call.',
  'On the call we go through your agents and the frameworks you report against, and where gaps are likely.',
  'If there is a fit, we send a fixed-scope proposal for a governance assessment.',
];
---

<BaseLayout
  title="Contact us"
  {description}
  type="ContactPage"
  crumbs={[{ name: 'Contact', href: '/contact/' }]}
>
  <PageHeader
    eyebrow="Contact"
    title="Talk to us about your AI agents"
    lede="Tell us which AI agents you run or plan to run, and what worries you about them. A short call is usually enough to see whether an assessment makes sense."
  />

  <section class="section">
    <div class="container layout">
      <div class="form-wrap">
        <h2 class="visually-hidden">Send us a message</h2>
        <ContactForm />
      </div>

      <aside class="side">
        <div>
          <h2 class="h">What happens next</h2>
          <ol class="next">
            {next.map((n, i) => (
              <li>
                <span class="num">{i + 1}</span>
                {n}
              </li>
            ))}
          </ol>
        </div>

        <div>
          <h2 class="h">Reach us directly</h2>
          <dl>
            <div>
              <dt>Email</dt>
              <dd><a href={`mailto:${site.email}`}>{site.email}</a></dd>
            </div>
            <div>
              <dt>Phone</dt>
              <dd><a href={`tel:${site.phone}`}>{site.phoneDisplay}</a></dd>
            </div>
            <div>
              <dt>Office</dt>
              <dd>
                <address>
                  {site.address.street}<br />
                  {`${site.address.locality}, ${site.address.region} ${site.address.postalCode}`}
                </address>
              </dd>
            </div>
          </dl>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .layout {
    display: grid;
    gap: 4rem;
  }

  @media (min-width: 60rem) {
    .layout {
      grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
      gap: 5rem;
    }
  }

  .side {
    display: grid;
    gap: 3rem;
    align-content: start;
  }

  .h {
    font-size: var(--step-2);
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--ink);
  }

  .next {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .next li {
    display: grid;
    grid-template-columns: 2rem 1fr;
    gap: 0.5rem;
    padding-block: 1rem;
    border-bottom: 1px solid var(--rule);
    color: var(--ink-soft);
    line-height: 1.5;
  }

  .num {
    font-family: var(--font-display);
    font-size: var(--step-1);
    line-height: 1.2;
    color: var(--accent);
  }

  dl > div {
    display: grid;
    gap: 0.25rem;
    padding-block: 1rem;
    border-bottom: 1px solid var(--rule);
  }

  dt {
    font-size: var(--step--1);
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  dd a {
    text-underline-offset: 0.2em;
  }
</style>
