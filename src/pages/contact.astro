---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import ContactForm from '../components/ContactForm.astro';
import { site } from '../data/site';

const description =
  'Book a call with AI Lab Consulting about governing the AI agents your firm runs or plans to run.';
---

<BaseLayout title="Book a call" {description} type="ContactPage" crumbs={[{ name: 'Contact', href: '/contact/' }]}>
  <PageHeader
    eyebrow="Contact"
    title="Book a call"
    lede="Tell us which AI agents you run or plan to run. We'll reply to set up a short call."
  />

  <section class="section">
    <div class="container layout">
      <div>
        <h2 class="visually-hidden">Send us a message</h2>
        <ContactForm />
      </div>

      <aside class="direct">
        <h2>Or reach us directly</h2>
        <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
        <p><a href={`tel:${site.phone}`}>{site.phoneDisplay}</a></p>
        <p class="muted">{`${site.address.locality}, California`}</p>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .layout {
    display: grid;
    gap: 3rem;
  }

  @media (min-width: 60rem) {
    .layout {
      grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
      gap: 5rem;
    }
  }

  .direct {
    display: grid;
    gap: 0.6rem;
    align-content: start;
  }

  .direct h2 {
    font-size: var(--step-2);
    padding-bottom: 1rem;
    margin-bottom: 0.5rem;
    border-bottom: 1px solid var(--ink);
  }

  .direct a {
    text-underline-offset: 0.2em;
  }
</style>
