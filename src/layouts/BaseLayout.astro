---
import { Font } from 'astro:assets';
import { site } from '../data/site';
import { graph } from '../lib/schema';
import '../styles/global.css';

interface Props {
  /** Page title without the site name. Omit on the home page. */
  title?: string;
  description: string;
  withServices?: boolean;
  noindex?: boolean;
}

const { title, description, withServices = false, noindex = false } = Astro.props;

const fullTitle = title ? `${title} | ${site.name}` : `${site.name} | AI governance for financial services`;
const canonical = new URL(Astro.url.pathname, site.url).href;
const ogImage = new URL('/og.png', site.url).href;
const ldJson = graph({ path: Astro.url.pathname, title: fullTitle, description, withServices });
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#ffffff" />

    <Font cssVariable="--font-sans" preload={[{ weight: '400' }, { weight: '600' }]} />

    <script type="application/ld+json" set:html={JSON.stringify(ldJson)} />

    {
      site.ga4Id && (
        <>
          <script async src={`https://www.googletagmanager.com/gtag/js?id=${site.ga4Id}`} />
          <script is:inline define:vars={{ id: site.ga4Id }}>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              dataLayer.push(arguments);
            }
            gtag('js', new Date());
            gtag('config', id);
          </script>
        </>
      )
    }
  </head>
  <body>
    <header class="container site-header">
      <a href="/" class="brand">
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
          <circle cx="7" cy="17" r="4" fill="none" stroke="currentColor" stroke-width="2"></circle>
          <path d="M9.9 14.1 13.6 10.4" stroke="currentColor" stroke-width="2"></path>
          <rect x="13" y="3" width="8" height="8" fill="var(--accent)"></rect>
        </svg>
        {site.name}
      </a>
      <nav aria-label="Primary">
        <a href="/#services">Services</a>
        <a href="/#about">About</a>
        <a href="/#contact">Contact</a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="container site-footer">
      <p>
        © {year}
        {site.name} · {site.address.locality}, California · <a href={`mailto:${site.email}`}>{site.email}</a>
      </p>
    </footer>
  </body>
</html>

<style>
  .site-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--rule);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text);
    font-weight: 600;
    text-decoration: none;
  }

  nav {
    display: flex;
    gap: 1.5rem;
    font-size: 0.95rem;
  }

  nav a {
    color: var(--text);
    text-decoration: none;
  }

  nav a:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  .site-footer {
    padding-block: 1.5rem 2rem;
    border-top: 1px solid var(--rule);
    color: var(--muted);
    font-size: 0.9rem;
  }
</style>
