---
interface Props {
  title?: string;
  text?: string;
}

const {
  title = 'Start with a governance assessment',
  text = 'We review your agents and how their actions are approved and recorded, then map the gaps to the frameworks you report against. Scope and fee are agreed before we begin.',
} = Astro.props;
---

<section class="cta-band" aria-labelledby="cta-title">
  <div class="container inner">
    <h2 id="cta-title">{title}</h2>
    <div class="body">
      <p>{text}</p>
      <a href="/contact/" class="btn btn-light">Book an assessment call <span class="arrow" aria-hidden="true">→</span></a>
    </div>
  </div>
</section>

<style>
  .cta-band {
    background: var(--ink);
    color: var(--on-ink);
    padding-block: clamp(4rem, 9vw, 7rem);
    --logo-accent: var(--on-ink);
  }

  .inner {
    display: grid;
    gap: 2rem;
  }

  @media (min-width: 60rem) {
    .inner {
      grid-template-columns: 7fr 5fr;
      align-items: start;
      gap: 4rem;
    }
  }

  h2 {
    font-size: var(--step-4);
  }

  .body {
    display: grid;
    gap: 1.75rem;
    justify-items: start;
  }

  p {
    color: var(--on-ink-muted);
    font-size: var(--step-1);
    line-height: 1.5;
  }
</style>
