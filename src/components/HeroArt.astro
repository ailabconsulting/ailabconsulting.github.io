---
// The logo mark drawn large: where you are today (circle) to audit-ready (square),
// with the engagement steps marked along the way.
import { process } from '../data/process';
const stages = process.map((s) => s.title);
const start = { x: 99.8, y: 360.2 };
const end = { x: 350, y: 110 };
const at = (t: number) => ({ x: start.x + (end.x - start.x) * t, y: start.y + (end.y - start.y) * t });
---

<svg class="hero-art" viewBox="0 0 460 460" role="img" aria-labelledby="hero-art-title">
  <title id="hero-art-title">Three steps between today and audit-ready: assess, build and hand over</title>
  <defs>
    <pattern id="dots" width="20" height="20" patternUnits="userSpaceOnUse">
      <circle cx="1" cy="1" r="1" fill="var(--rule)"></circle>
    </pattern>
    <radialGradient id="fade" cx="50%" cy="50%" r="55%">
      <stop offset="0.35" stop-color="#fff"></stop>
      <stop offset="1" stop-color="#000"></stop>
    </radialGradient>
    <mask id="fade-mask"><rect width="460" height="460" fill="url(#fade)"></rect></mask>
  </defs>

  <rect width="460" height="460" fill="url(#dots)" mask="url(#fade-mask)"></rect>

  <circle class="idea" cx="80" cy="380" r="28"></circle>
  <text class="end-label" x="80" y="438" text-anchor="middle">Today</text>

  <line class="path" x1={start.x} y1={start.y} x2={end.x} y2={end.y} pathLength="1"></line>

  {
    stages.map((label, i) => {
      const p = at((i + 1) / (stages.length + 1));
      return (
        <g class="stage" style={`--i:${i}`}>
          <circle cx={p.x} cy={p.y} r="4.5" />
          <text x={p.x + 16} y={p.y + 22}>
            <tspan class="stage-num">{String(i + 1).padStart(2, '0')}</tspan> {label}
          </text>
        </g>
      );
    })
  }

  <rect class="product" x="350" y="38" width="72" height="72"></rect>
  <text class="end-label" x="336" y="62" text-anchor="end">Audit-ready</text>
</svg>

<style>
  .hero-art {
    width: 100%;
    max-width: 25rem;
    height: auto;
    overflow: visible;
  }

  .idea {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.5;
  }

  .path {
    stroke: var(--ink);
    stroke-width: 1.5;
  }

  .stage circle {
    fill: var(--paper);
    stroke: var(--ink);
    stroke-width: 1.5;
  }

  .stage text {
    font-family: var(--font-body);
    font-size: 12.5px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    fill: var(--ink-muted);
  }

  .stage-num {
    fill: var(--accent);
  }

  .product {
    fill: var(--accent);
  }

  .end-label {
    font-family: var(--font-display);
    font-size: 20px;
    font-style: italic;
    fill: var(--ink-soft);
  }

  @media (prefers-reduced-motion: no-preference) {
    .path {
      stroke-dasharray: 1;
      animation: draw 1.4s 0.2s var(--ease) both;
    }
    .stage {
      animation: fade 0.5s calc(0.45s + var(--i) * 0.25s) var(--ease) both;
    }
    .product {
      transform-origin: 386px 74px;
      animation: pop 0.6s 1.45s var(--ease) both;
    }
  }

  @keyframes draw {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes fade {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
  }

  @keyframes pop {
    from {
      opacity: 0;
      transform: scale(0.6);
    }
  }
</style>
