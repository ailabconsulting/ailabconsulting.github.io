---
import type { Faq } from '../data/faqs';

interface Props {
  faqs: Faq[];
}

const { faqs } = Astro.props;
---

<div class="faq">
  {
    faqs.map((f, i) => (
      <details open={i === 0}>
        <summary>
          <h3>{f.q}</h3>
          <span class="icon" aria-hidden="true" />
        </summary>
        <p>{f.a}</p>
      </details>
    ))
  }
</div>

<style>
  .faq {
    border-top: 1px solid var(--ink);
  }

  details {
    border-bottom: 1px solid var(--rule);
  }

  summary {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 1.4rem;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  h3 {
    font-size: var(--step-1);
    line-height: 1.3;
  }

  summary:hover h3 {
    color: var(--accent);
  }

  .icon {
    position: relative;
    flex: none;
    width: 0.9rem;
    height: 0.9rem;
  }

  .icon::before,
  .icon::after {
    content: '';
    position: absolute;
    inset: 50% 0 auto;
    height: 1.5px;
    background: currentColor;
    transition: transform 0.25s var(--ease);
  }

  .icon::after {
    transform: rotate(90deg);
  }

  details[open] .icon::after {
    transform: rotate(0deg);
  }

  p {
    max-width: 44rem;
    padding-bottom: 1.6rem;
    color: var(--ink-soft);
  }
</style>
