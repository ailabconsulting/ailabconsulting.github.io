---
interface Props {
  eyebrow: string;
  title: string;
  lede?: string;
}

const { eyebrow, title, lede } = Astro.props;
---

<header class="page-header">
  <div class="container">
    <p class="eyebrow">{eyebrow}</p>
    <h1>{title}</h1>
    {lede && <p class="lede">{lede}</p>}
    <slot />
  </div>
</header>

<style>
  .page-header {
    padding-block: clamp(2.5rem, 6vw, 4.5rem) clamp(3rem, 7vw, 5.5rem);
    border-bottom: 1px solid var(--rule);
  }

  h1 {
    margin-top: 1.5rem;
    max-width: 20ch;
    font-size: var(--step-5);
    font-weight: 350;
    line-height: 1.04;
    letter-spacing: -0.022em;
  }

  .lede {
    margin-top: 1.75rem;
  }
</style>
