---
import { getCollection } from 'astro:content';
import Logo from './Logo.astro';
import { site } from '../data/site';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container grid">
    <div class="about">
      <a href="/" class="brand" aria-label="AI Lab Consulting home"><Logo /></a>
      <p class="tagline">{site.tagline}</p>
      <address>
        <a href={`mailto:${site.email}`}>{site.email}</a><br />
        <a href={`tel:${site.phone}`}>{site.phoneDisplay}</a><br />
        {`${site.address.locality}, ${site.address.region}`}
      </address>
    </div>

    <nav aria-labelledby="footer-services">
      <h2 id="footer-services">Services</h2>
      <ul>
        {services.map((s) => <li><a href={`/services/${s.id}/`}>{s.data.title}</a></li>)}
      </ul>
    </nav>

    <nav aria-labelledby="footer-company">
      <h2 id="footer-company">Company</h2>
      <ul>
        <li><a href="/#how">How we work</a></li>
        <li><a href="/about/">About</a></li>
        <li><a href="/contact/">Contact</a></li>
      </ul>
    </nav>
  </div>

  <div class="container base">
    <p>© {year} {site.name}</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--paper-sunk);
    border-top: 1px solid var(--rule);
    padding-top: clamp(3rem, 6vw, 4.5rem);
    font-size: 0.95rem;
  }

  .grid {
    display: grid;
    gap: 2.5rem 2rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .about {
    grid-column: 1 / -1;
  }

  @media (min-width: 56rem) {
    .grid {
      grid-template-columns: minmax(0, 2fr) repeat(2, minmax(0, 1fr));
    }
    .about {
      grid-column: auto;
    }
  }

  .brand {
    display: inline-block;
    color: var(--ink);
    text-decoration: none;
  }

  .tagline {
    margin-top: 1rem;
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-style: italic;
    color: var(--ink-soft);
  }

  address {
    margin-top: 1.25rem;
    color: var(--ink-muted);
    line-height: 1.7;
  }

  address a,
  ul a {
    text-decoration: none;
  }

  address a:hover,
  ul a:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  h2 {
    font-family: var(--font-body);
    font-size: var(--step--1);
    font-weight: 500;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--ink-muted);
    margin-bottom: 1rem;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }

  .base {
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    padding-block: 1.25rem;
    border-top: 1px solid var(--rule);
    color: var(--ink-muted);
    font-size: var(--step--1);
  }
</style>
