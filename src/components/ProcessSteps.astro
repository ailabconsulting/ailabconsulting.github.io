---
import { process } from '../data/process';

interface Props {
  /** Show the longer description of each stage. */
  detailed?: boolean;
}

const { detailed = false } = Astro.props;
---

<ol class:list={['steps', { detailed }]}>
  {
    process.map((step, i) => (
      <li>
        <div class="meta">
          <span class="num">{String(i + 1).padStart(2, '0')}</span>
        </div>
        <h3>{step.title}</h3>
        <p>{step.summary}</p>
        {detailed && <p class="detail">{step.detail}</p>}
      </li>
    ))
  }
</ol>

<style>
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0;
  }

  li {
    position: relative;
    display: grid;
    gap: 0.75rem;
    align-content: start;
    padding: 1.75rem 0 2rem;
    border-top: 1px solid var(--ink);
  }

  .meta {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-size: var(--step--1);
    font-variant-numeric: tabular-nums;
  }

  .num {
    color: var(--ink-muted);
  }

  h3 {
    font-size: var(--step-2);
  }

  p {
    color: var(--ink-soft);
    line-height: 1.5;
  }

  .detail {
    color: var(--ink-muted);
  }

  @media (min-width: 60rem) {
    .steps:not(.detailed) {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      column-gap: 2rem;
    }
  }

  @media (min-width: 48rem) {
    .detailed li {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
      column-gap: 2rem;
      padding-block: 2.25rem 2.75rem;
    }
    .detailed .meta {
      grid-row: span 3;
      flex-direction: column;
      align-items: start;
      justify-content: start;
      gap: 0.75rem;
    }
    .detailed .num {
      font-family: var(--font-display);
      font-size: var(--step-4);
      line-height: 1;
      color: var(--ink);
    }
  }
</style>
