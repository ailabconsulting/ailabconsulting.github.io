---
import type { CollectionEntry } from 'astro:content';

interface Props {
  services: CollectionEntry<'services'>[];
  headingLevel?: 'h2' | 'h3';
}

const { services, headingLevel: H = 'h3' } = Astro.props;
---

<ol class="index">
  {
    services.map((s) => (
      <li>
        <a href={`/services/${s.id}/`}>
          <span class="num">{String(s.data.order).padStart(2, '0')}</span>
          <H class="title">{s.data.title}</H>
          <p class="summary">{s.data.summary}</p>
          <span class="arrow" aria-hidden="true">→</span>
        </a>
      </li>
    ))
  }
</ol>

<style>
  .index {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--ink);
  }

  li {
    border-bottom: 1px solid var(--rule);
  }

  a {
    display: grid;
    grid-template-columns: 2.5rem 1fr auto;
    grid-template-areas:
      'num title arrow'
      '. summary .';
    column-gap: 1rem;
    row-gap: 0.4rem;
    padding-block: 1.5rem;
    text-decoration: none;
    transition: background-color 0.25s var(--ease);
  }

  @media (min-width: 48rem) {
    a {
      grid-template-columns: 3.5rem minmax(0, 5fr) minmax(0, 6fr) 2rem;
      grid-template-areas: 'num title summary arrow';
      align-items: baseline;
      column-gap: 1.5rem;
      padding-block: 1.75rem;
    }
  }

  .num {
    grid-area: num;
    font-size: var(--step--1);
    font-variant-numeric: tabular-nums;
    color: var(--ink-muted);
  }

  .title {
    grid-area: title;
    font-size: var(--step-2);
    line-height: 1.15;
    transition: color 0.2s var(--ease);
  }

  .summary {
    grid-area: summary;
    color: var(--ink-soft);
    line-height: 1.5;
  }

  .arrow {
    grid-area: arrow;
    justify-self: end;
    font-size: var(--step-1);
    transition: transform 0.25s var(--ease);
  }

  a:hover .title {
    color: var(--accent);
  }

  a:hover .arrow {
    transform: translateX(0.3rem);
    color: var(--accent);
  }
</style>
